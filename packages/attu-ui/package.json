{
    "name": "@attu/ui",
    "version": "0.1.0",
    "private": true,
    "description": "shared svelte 5 + tailwind v4 component library for the attu project",
    "license": "MIT",
    "type": "module",
    "packageManager": "pnpm@10.33.2",
    "engines": {
        "node": ">=22",
        "pnpm": ">=10"
    },
    "exports": {
        ".": {
            "svelte": "./src/lib/index.ts",
            "types": "./src/lib/index.ts",
            "default": "./src/lib/index.ts"
        },
        "./pure": {
            "types": "./src/lib/pure.ts",
            "default": "./src/lib/pure.ts"
        },
        "./theme.css": "./src/lib/theme.css"
    },
    "files": [
        "src/lib"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "svelte-check --tsconfig ./tsconfig.json",
        "lint": "eslint . && prettier --check .",
        "format": "prettier --write .",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "verify": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm build"
    },
    "peerDependencies": {
        "svelte": "^5.0.0",
        "tailwindcss": "^4.0.0"
    },
    "dependencies": {
        "@attu/api-client": "workspace:*",
        "@fontsource-variable/inter": "^5.2.8",
        "@fontsource/jetbrains-mono": "^5.2.8",
        "@lucide/svelte": "^1.22.0",
        "svelte": "^5.56.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tailwindcss/vite": "^4.3.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/svelte": "^5.4.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^26.0.1",
        "eslint": "^10.6.0",
        "eslint-plugin-svelte": "^3.20.0",
        "fake-indexeddb": "^6.2.5",
        "globals": "^17.7.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.3",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "svelte-check": "^4.7.1",
        "tailwindcss": "^4.3.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.1",
        "vite": "^8.1.0",
        "vitest": "^4.1.9"
    }
}
