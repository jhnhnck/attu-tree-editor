{
    "name": "web",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "svelte-check --tsconfig ./tsconfig.json",
        "lint": "eslint . && prettier --check .",
        "format": "prettier --write .",
