        "prettier-plugin-tailwindcss": "^0.6.0",
        "svelte-check": "^4.0.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.6.0",
        "typescript-eslint": "^8.0.0",
        "vite": "^6.0.0",
        "vitest": "^3.0.0"
    }
